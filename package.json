{
  "name": "araccoon-hub",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiteshPatil2610/Araccoon-hub.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "articles": "tsx scripts/articles.ts",
    "prebuild": "tsx scripts/articles.ts",
    "pretypecheck": "tsx scripts/articles.ts",
    "pretest": "tsx scripts/articles.ts",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test --test-global-setup=tests/support/globalPostgres.ts --test-concurrency=4 \"tests/**/*.test.ts\"",
    "test:security": "node scripts/security-test.mjs",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "owner:password": "tsx scripts/owner-password.ts",
    "deploy": "npm run typecheck && npm run test:security && vite build --configLoader runner && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "cheerio": "^1.2.0",
    "hono": "^4.13.17",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
