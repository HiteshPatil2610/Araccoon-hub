{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/editorial/**",
              "components/motion/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Archivo))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowPair'] > JSXAttribute > JSXIdentifier[name!=/^(?:onPrev|onNext|tone|style|key|ref|className|style|children)$/]",
        "message": "<ArrowPair> doesn't accept that prop. Declared props: onPrev, onNext, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowPair'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<ArrowPair> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarStackItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|color|mono|key|ref|className|style|children)$/]",
        "message": "<AvatarStackItem> doesn't accept that prop. Declared props: name, src, color, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookingCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|cinema|date|time|mapSrc|onBook|onMap|style|key|ref|className|style|children)$/]",
        "message": "<BookingCard> doesn't accept that prop. Declared props: kicker, title, cinema, date, time, mapSrc, onBook, onMap, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tone|size|icon|children|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, tone, size, icon, children, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|bar|ghost)$/]",
        "message": "<Button> variant must be one of 'outline' | 'solid' | 'bar' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Button> tone must be one of 'dark' | 'light'."
