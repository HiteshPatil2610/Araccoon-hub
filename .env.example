# =============================================================================
# Araccoon Hub — environment template. Copy to `.env` (never commit `.env`).
# Local development reads `.env`, then `.env.local` (local overrides win).
# Production values go in Cloudflare: Workers → araccoon-hub → Settings →
# Variables and Secrets (use type "Secret" for anything marked 🔒), or
# `npx wrangler secret put NAME`.
# Full sign-up steps: see NEW-PROJECT-SETUP.md in the old project.
# =============================================================================

# ---- Database (Neon) ----
# Production branch, used by `npm run db:migrate -- --target=prod` and by
# `wrangler hyperdrive create`. Must end with ?sslmode=verify-full.
DATABASE_URL=                 # 🔒
# Dev branch, used by `npm run dev` / `db:seed`. Leave empty to use the local
# Postgres started by `npm run db:local`.
DATABASE_URL_DEV=             # 🔒

# ---- Owner sign-in (passkeys) ----
SESSION_SECRET=               # 🔒 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RECOVERY_CODE_PEPPER=         # 🔒 32+ random chars (same command)
# The only email that can create the FIRST owner passkey, together with the
# one-time OWNER_SETUP_TOKEN. Setup closes forever once a passkey exists.
OWNER_EMAIL=
OWNER_SETUP_TOKEN=            # 🔒 random (same command); remove after setup
# Passkeys are bound to this host. Production: your workers.dev or custom host.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:5173

# ---- Bot protection (Cloudflare Turnstile) ----
TURNSTILE_SITE_KEY=           # public
TURNSTILE_SECRET_KEY=         # 🔒

# ---- Images (Cloudinary, signed upload preset) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=        # 🔒
CLOUDINARY_UPLOAD_PRESET=raccoon-products

# ---- Rate limiting (Upstash Redis REST) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=     # 🔒

# ---- Amazon Associates ----
# One tag for every store, or per store:  amazon.in=yourid-21,amazon.com=yourid-20
# Replaces tags in pasted links; a product's explicit owner tracking-ID override takes precedence.
AMAZON_ASSOCIATE_TAG=
# Approved destination hosts (also set in wrangler.jsonc "vars").
AFFILIATE_ALLOWED_HOSTS=amazon.com,amazon.in,amzn.to,amzn.in

# ---- Optional ----
# WEBHOOK_SECRET=             # 🔒 enables POST /api/webhooks/conversion
# SENTRY_DSN=

# ---- Local development only (put these in .env.local, not production) ----
# ENVIRONMENT=development     # relaxes required production secrets locally
# DEV_LOGIN_TOKEN=            # enables the dev-only sign-in box on localhost
